{
  "expo": {
    "name": "Leben in Deutschland",
    "slug": "leben-in-deutschland",
    "scheme": "lebenindeutschland",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.lebenindeutschland.app"
    },
    "android": {
      "package": "de.lebenindeutschland.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
